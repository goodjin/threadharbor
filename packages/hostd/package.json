{
  "name": "@threadharbor/hostd",
  "version": "0.1.0",
  "description": "Persistent ThreadHarbor host daemon",
  "repository": { "type": "git", "url": "git+https://github.com/goodjin/threadharbor.git", "directory": "packages/hostd" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/server.d.ts",
  "bin": { "threadharbor-hostd": "lib/bin.js" },
  "exports": {
    ".": {
      "types": "./lib/types/server.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/bin.js", "lib/hold-worker.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@threadharbor/protocol": "workspace:^",
    "commander": "^15.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
