{
  "name": "@goodjin2/dsh-threadharbor",
  "version": "0.1.0",
  "description": "Multi-host federation for DeepSeek Harness Web: host registry, cross-machine sidebar, pairing, SSH deploy, plus the browser UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodjin/threadharbor.git"
  },
  "homepage": "https://github.com/goodjin/threadharbor#readme",
  "bugs": {
    "url": "https://github.com/goodjin/threadharbor/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "deploy/**/*.yml",
    "docs/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@goodjin2/dsh-host-federation": "workspace:^",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3",
    "react": "^18.2.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare-install.mjs",
    "reference:checkout": "bash scripts/checkout-reference.sh",
    "reference:checkout-mobile": "bash scripts/checkout-reference-mobile.sh",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build": "bash scripts/build.sh",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "release:candidate": "node scripts/release-promote.mjs candidate",
    "release:promote": "node scripts/release-promote.mjs promote",
    "release:status": "node scripts/release-promote.mjs status",
    "sessions:check": "node scripts/repair-session-log.mjs --scan ~/.dsh/sessions ~/.dsh-web/sessions",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.1.7-rc.2",
    "@shikijs/langs": "^4.5.0",
    "@tanstack/virtual-core": "3.17.7",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^11.1.21",
    "jsdom": "^27.0.0",
    "katex": "^0.19.0",
    "lightningcss": "^1.30.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "tsdown": "^0.15.12",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  }
}
